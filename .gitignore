# Raw and processed data never enters version control.
# iTrust terms restrict redistribution, and the files are large.
data/raw/*
data/processed/*
!data/**/.gitkeep

# Results are reproducible artefacts, but keep the summary tables
results/*
!results/.gitkeep
!results/*.md

# swat-preprocess is vendored EDA tooling; its data/fig outputs are derived
# from the same iTrust-restricted SWaT files and are regenerated locally.
swat-preprocess/data/*
!swat-preprocess/data/README.md
swat-preprocess/fig/*

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
*.log
